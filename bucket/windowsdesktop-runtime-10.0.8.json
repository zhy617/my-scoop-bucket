{
    "version": "10.0.8",
    "description": "Microsoft .NET 10.0 Desktop Runtime",
    "homepage": "https://dotnet.microsoft.com/download/dotnet",
    "license": "MIT",
    "notes": "You can now remove this installer with 'scoop uninstall -p windowsdesktop-runtime-10.0.8'",
    "architecture": {
        "64bit": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/10.0.8/windowsdesktop-runtime-10.0.8-win-x64.zip",
            "hash": "sha512:3dcd7b490966ef44c5074e33d2253563939654eca65eb74a2045c82b4dfa5d13077a1de9533971aee8b3fa9daf9cf968820285629beae09ecfa2b047ff2535ea"
        },
        "32bit": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/10.0.8/windowsdesktop-runtime-10.0.8-win-x86.zip",
            "hash": "sha512:46ab7b9ca355007bdf07b7cd6b8ec1766cabd63dfdb69772a60ba5267ab3ff304daceab985426935d5761bb4777f9bfa375f948f13104403365d8d951ced609c"
        },
        "arm64": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/10.0.8/windowsdesktop-runtime-10.0.8-win-arm64.zip",
            "hash": "sha512:04a05ab74696f987c780d577e1f9acdfbf71156ba6a4141be5540315bd09edd518c82685ad7873a79172b8d6fbdea3203093a89f0e3826335c3b2199ac3a6d70"
        }
    },
    "pre_install": "if (!(is_admin)) { error 'Admin privileges are required.'; break }",
    "installer": {
        "script": [
            "$target = Join-Path $env:ProgramFiles 'dotnet'",
            "$shared = Join-Path $target 'shared'",
            "New-Item -ItemType Directory -Path $shared -Force | Out-Null",
            "Copy-Item \"$dir\\shared\\Microsoft.NETCore.App\" $shared -Recurse -Force",
            "Copy-Item \"$dir\\shared\\Microsoft.WindowsDesktop.App\" $shared -Recurse -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$target = Join-Path $env:ProgramFiles 'dotnet'",
            "Remove-Item (Join-Path $target 'shared\\Microsoft.NETCore.App\\10.0.8') -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item (Join-Path $target 'shared\\Microsoft.WindowsDesktop.App\\10.0.8') -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    }
}
