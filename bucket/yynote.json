{
    "version": "26.03.01",
    "description": "小黄条：可嵌入 Windows 桌面的跨平台待办清单。",
    "homepage": "https://www.yynote.cn",
    "license": "Freeware",
    "url": "https://d.yynote.cn/windows/YYNote.exe",
    "hash": "ba9335a07e8afe3a77959815ae7709425d849ebb62284f7e73bbb8f5f0cb0d21",
    "bin": "YYNote\\YYNote.exe",
    "shortcuts": [
        [
            "YYNote\\YYNote.exe",
            "YYNote"
        ]
    ],
    "checkver": {
        "url": "https://www.yynote.cn",
        "script": [
            "$tmp = Join-Path $env:TEMP 'yynote-checkver.exe'",
            "Invoke-WebRequest -Uri 'https://d.yynote.cn/windows/YYNote.exe' -OutFile $tmp -UseBasicParsing",
            "$v = (Get-Item $tmp).VersionInfo.ProductVersion.Trim()",
            "Remove-Item $tmp -Force -ErrorAction SilentlyContinue",
            "Write-Output $v"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://d.yynote.cn/windows/YYNote.exe"
    }
}
