{
    "version": "2.0.99.0",
    "description": "Check AirPods battery on Windows with popup animation, noise control, hotkeys, and more.",
    "homepage": "https://magicpods.app/",
    "license": "Proprietary",
    "url": "https://magicpods.app/installer/MagicPods.appinstaller#/MagicPods.appinstaller",
    "hash": "70c3efe6dea330425bff2394ae40f3bf03e58b65edcf55ba4869e1fa9cd30f80",
    "installer": {
        "script": [
            "Add-AppxPackage -Path \"$dir\\MagicPods.appinstaller\" -AppInstallerFile",
            "$package = Get-AppxPackage -Name '715AleksandrMaslov.MagicPods' -ErrorAction SilentlyContinue",
            "if (-not $package) { throw 'MagicPods AppX package was not installed.' }"
        ]
    },
    "uninstaller": {
        "script": [
            "$packages = @(Get-AppxPackage -Name '715AleksandrMaslov.MagicPods' -ErrorAction SilentlyContinue)",
            "foreach ($package in $packages) { Remove-AppxPackage -Package $package.PackageFullName }"
        ]
    },
    "checkver": {
        "url": "https://magicpods.app/installer/MagicPods.appinstaller",
        "regex": "Version=\"([\\d.]+)\""
    },
    "autoupdate": {
        "url": "https://magicpods.app/installer/MagicPods.appinstaller#/MagicPods.appinstaller",
        "hash": {
            "mode": "download"
        }
    },
    "notes": "MagicPods is installed as a Windows packaged app. The Start Menu entry is created by Windows, and Scoop uninstall removes the AppX package for the current user."
}
