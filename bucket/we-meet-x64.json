{
    "version":  "3.47.2.405",
    "description":  "Tencent Meeting (64-bit)",
    "homepage":  "https://meeting.tencent.com/",
    "license":  {
                    "identifier":  "Freeware"
                },
    "architecture":  {
                         "64bit":  {
                                       "url":  "https://raw.githubusercontent.com/zhy617/my-scoop-bucket/master/LICENSE#/wemeet-bootstrap.txt",
                                       "hash":  "sha256:6b0382b16279f26ff69014300541967a356a666eb0b91b422f6862f6b7dad17e",
                                       "pre_install":  [
                                                           "$packageUrl = \u0027https://updatecdn.meeting.qq.com/cos/bb80d852af40cbffe3ed5e22f27d7a86/TencentMeeting_0300000000_3.47.2.405_x86_64.publish.officialwebsite.exe\u0027",
                                                           "$packageSha256 = \u00271c7a862cfca4b3faeb1cf9c2244e97f09accf65c0256e690d7c3f7f2f99c71f7\u0027",
                                                           "$packageCache = cache_path \u0027we-meet-x64\u0027 $version ($packageUrl + \u0027#/dl.7z\u0027)",
                                                           "$cacheValid = (Test-Path -LiteralPath $packageCache) -and ((Get-FileHash -LiteralPath $packageCache -Algorithm SHA256).Hash -eq $packageSha256)",
                                                           "if (!$cacheValid) {",
                                                           "    New-Item -ItemType Directory -Path (Split-Path $packageCache) -Force | Out-Null",
                                                           "    $partial = $packageCache + \u0027.download-\u0027 + [guid]::NewGuid().ToString(\u0027N\u0027)",
                                                           "    $client = New-Object System.Net.WebClient",
                                                           "    try {",
                                                           "        $client.Headers[\u0027Referer\u0027] = \u0027https://meeting.tencent.com/\u0027",
                                                           "        $client.Headers[\u0027User-Agent\u0027] = Get-UserAgent",
                                                           "        Write-Host \"Downloading Tencent Meeting $version with the official Referer...\"",
                                                           "        $client.DownloadFile($packageUrl, $partial)",
                                                           "        if ((Get-FileHash -LiteralPath $partial -Algorithm SHA256).Hash -ne $packageSha256) { throw \u0027Tencent Meeting package SHA256 mismatch.\u0027 }",
                                                           "        Move-Item -LiteralPath $partial -Destination $packageCache -Force",
                                                           "    } finally {",
                                                           "        $client.Dispose()",
                                                           "        if (Test-Path -LiteralPath $partial) { Remove-Item -LiteralPath $partial -Force }",
                                                           "    }",
                                                           "}",
                                                           "Expand-7zipArchive -Path $packageCache -DestinationPath $dir"
                                                       ]
                                   }
                     },
    "installer":  {
                      "script":  [
                                     "Get-Item \"$dir\\`$_*_\" | Rename-Item -NewName \"$version\"",
                                     "Move-Item \"$dir\\wemeetapp_new.exe\" \"$dir\\WeMeet.exe\"",
                                     "Remove-Item -Recurse -Path \"$dir\\`$WINDIR\",\"$dir\\`$PLUGINSDIR\",\"$dir\\`$TEMP\",\"$dir\\wemeetapp.exe\""
                                 ]
                  },
    "shortcuts":  [
                      [
                          "WeMeet.exe",
                          "腾讯会议 64 位"
                      ]
                  ],
    "depends":  "7zip"
}
