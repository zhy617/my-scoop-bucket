{
    "version":  "3.49.1.410",
    "description":  "Tencent Meeting (64-bit)",
    "homepage":  "https://meeting.tencent.com/",
    "license":  {
                    "identifier":  "Freeware"
                },
    "architecture":  {
                         "64bit":  {
                                       "url":  "https://raw.githubusercontent.com/zhy617/my-scoop-bucket/master/LICENSE#/wemeet-bootstrap.txt",
                                       "hash":  "sha256:6b0382b16279f26ff69014300541967a356a666eb0b91b422f6862f6b7dad17e",
                                       "pre_install":  [
                                                           "$packageUrl = \u0027https://updatecdn.meeting.qq.com/cos/b23c1f5388a251ca939d93afe30bf946/TencentMeeting_0300000000_3.49.1.410_x86_64.publish.officialwebsite.exe\u0027",
                                                           "$packageSha256 = \u0027651742b45ae2baf9ec570e1c9991738b396b041d6c90fa53532ea1913dee554a\u0027",
                                                           "# Self-contained package downloader (PowerShell 5.1+).",
                                                           "function Invoke-WeMeetDownload {",
                                                           "    [CmdletBinding()]",
                                                           "    param (",
                                                           "        [Parameter(Mandatory=$true)][string]$Url,",
                                                           "        [Parameter(Mandatory=$true)][string]$Destination,",
                                                           "        [string]$Sha256,",
                                                           "        [string]$Md5,",
                                                           "        [long]$ExpectedSize = 0",
                                                           "    )",
                                                           "    if (!$Sha256 -and !$Md5) { throw \u0027A pinned package hash is required.\u0027 }",
                                                           "    $packageUri = [uri]$Url",
                                                           "    if ($packageUri.Scheme -ne \u0027https\u0027 -or $packageUri.Host -ne \u0027updatecdn.meeting.qq.com\u0027) {",
                                                           "        throw \u0027Refusing to download from an unexpected Tencent Meeting host.\u0027",
                                                           "    }",
                                                           "    $curl = Get-Command curl.exe -ErrorAction Stop",
                                                           "    $common = @(\u0027--fail\u0027, \u0027--location\u0027, \u0027--silent\u0027, \u0027--show-error\u0027,",
                                                           "        \u0027--proto\u0027, \u0027=https\u0027, \u0027--proto-redir\u0027, \u0027=https\u0027,",
                                                           "        \u0027--connect-timeout\u0027, \u002710\u0027, \u0027--speed-limit\u0027, \u00271024\u0027, \u0027--speed-time\u0027, \u002720\u0027,",
                                                           "        \u0027--max-time\u0027, \u0027900\u0027, \u0027--referer\u0027, \u0027https://meeting.tencent.com/\u0027,",
                                                           "        \u0027--user-agent\u0027, \u0027Mozilla/5.0\u0027, \u0027--output\u0027, $Destination)",
                                                           "    $routes = @(\u0027default\u0027, \u0027direct\u0027, \u0027Tencent DNS\u0027)",
                                                           "    try {",
                                                           "        foreach ($route in $routes) {",
                                                           "            $routeArgs = @()",
                                                           "            if ($route -ne \u0027default\u0027) { $routeArgs = @(\u0027--noproxy\u0027, \u0027*\u0027) }",
                                                           "            if ($route -eq \u0027Tencent DNS\u0027) {",
                                                           "                # Ask Tencent\u0027s DoH service for a fresh CDN node. Keep the original",
                                                           "                # hostname for TLS/SNI and certificate checks; never pin a CDN IP.",
                                                           "                $dnsJson = \u0026 $curl \u0027--fail\u0027 \u0027--silent\u0027 \u0027--show-error\u0027 \u0027--noproxy\u0027 \u0027*\u0027 \u0027--connect-timeout\u0027 \u002710\u0027 \u0027--max-time\u0027 \u002720\u0027 \u0027https://doh.pub/resolve?name=updatecdn.meeting.qq.com\u0026type=A\u0027",
                                                           "                if ($LASTEXITCODE -ne 0) { continue }",
                                                           "                $dns = ($dnsJson -join \"`n\") | ConvertFrom-Json",
                                                           "                if ($dns.Status -ne 0) { continue }",
                                                           "                $addresses = @($dns.Answer | Where-Object { $_.type -eq 1 -and $_.data -match \u0027^\\d{1,3}(\\.\\d{1,3}){3}$\u0027 } | ForEach-Object { $_.data })",
                                                           "                if (!$addresses.Count) { continue }",
                                                           "                $routeArgs += @(\u0027--resolve\u0027, ($packageUri.Host + \u0027:443:\u0027 + ($addresses -join \u0027,\u0027)))",
                                                           "            }",
                                                           "            if (Test-Path -LiteralPath $Destination) { Remove-Item -LiteralPath $Destination -Force }",
                                                           "            Write-Host \"Downloading Tencent Meeting via $route...\"",
                                                           "            \u0026 $curl @common @routeArgs $Url",
                                                           "            $downloadExitCode = $LASTEXITCODE",
                                                           "            if ($downloadExitCode -ne 0) {",
                                                           "                Write-Warning \"Tencent Meeting download via $route failed (curl exit $downloadExitCode); trying the next route.\"",
                                                           "                continue",
                                                           "            }",
                                                           "            if (!(Test-Path -LiteralPath $Destination)) { throw \u0027Downloader did not create the package.\u0027 }",
                                                           "            if ($ExpectedSize -gt 0 -and (Get-Item -LiteralPath $Destination).Length -ne $ExpectedSize) { throw \u0027Tencent Meeting package size mismatch.\u0027 }",
                                                           "            if ($Md5 -and (Get-FileHash -LiteralPath $Destination -Algorithm MD5).Hash -ne $Md5) { throw \u0027Tencent Meeting package MD5 mismatch.\u0027 }",
                                                           "            if ($Sha256 -and (Get-FileHash -LiteralPath $Destination -Algorithm SHA256).Hash -ne $Sha256) { throw \u0027Tencent Meeting package SHA256 mismatch.\u0027 }",
                                                           "            return",
                                                           "        }",
                                                           "        throw \u0027Tencent Meeting download failed via default, direct and refreshed Tencent CDN routes.\u0027",
                                                           "    } catch {",
                                                           "        if (Test-Path -LiteralPath $Destination) { Remove-Item -LiteralPath $Destination -Force }",
                                                           "        throw",
                                                           "    }",
                                                           "}",
                                                           "$packageCache = cache_path \u0027we-meet-x64\u0027 $version ($packageUrl + \u0027#/dl.7z\u0027)",
                                                           "$cacheValid = (Test-Path -LiteralPath $packageCache) -and ((Get-FileHash -LiteralPath $packageCache -Algorithm SHA256).Hash -eq $packageSha256)",
                                                           "if (!$cacheValid) {",
                                                           "    New-Item -ItemType Directory -Path (Split-Path $packageCache) -Force | Out-Null",
                                                           "    $partial = $packageCache + \u0027.download-\u0027 + [guid]::NewGuid().ToString(\u0027N\u0027)",
                                                           "    try {",
                                                           "        Invoke-WeMeetDownload -Url $packageUrl -Destination $partial -Sha256 $packageSha256",
                                                           "        Move-Item -LiteralPath $partial -Destination $packageCache -Force",
                                                           "    } finally {",
                                                           "        if (Test-Path -LiteralPath $partial) { Remove-Item -LiteralPath $partial -Force }",
                                                           "    }",
                                                           "}",
                                                           "Expand-7zipArchive -Path $packageCache -DestinationPath $dir"
                                                       ]
                                   }
                     },
    "installer":  {
                      "script":  [
                                     "Get-Item \"$dir\\`$_*_\" | Rename-Item -NewName \"$version\"",
                                     "Move-Item \"$dir\\wemeetapp_new.exe\" \"$dir\\WeMeet.exe\"",
                                     "Remove-Item -Recurse -Path \"$dir\\`$WINDIR\",\"$dir\\`$PLUGINSDIR\",\"$dir\\`$TEMP\",\"$dir\\wemeetapp.exe\""
                                 ]
                  },
    "shortcuts":  [
                      [
                          "WeMeet.exe",
                          "腾讯会议 64 位"
                      ]
                  ],
    "depends":  [
                    "7zip",
                    "curl"
                ]
}
